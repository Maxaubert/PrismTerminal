{
  "name": "prism-term-core",
  "version": "0.2.0",
  "description": "The terminal shared by Prism Terminal and Prism: pty, shells, agent detection and indicator, themes, links, the panel. TypeScript source, compiled by the host.",
  "license": "MIT",
  "private": true,
  "sideEffects": [
    "./renderer/components/TerminalPanel.tsx",
    "**/*.css"
  ],
  "exports": {
    "./main/*": "./main/*.ts",
    "./preload/*": "./preload/*.ts",
    "./shared/*": "./shared/*.ts",
    "./renderer/host": "./renderer/host.ts",
    "./renderer/lib/*": "./renderer/lib/*.ts",
    "./renderer/components/*": "./renderer/components/*.tsx",
    "./renderer/settings/options": "./renderer/settings/options.ts",
    "./renderer/settings/*": "./renderer/settings/*.tsx",
    "./renderer/settings/dictationOptions": "./renderer/settings/dictationOptions.ts",
    "./tools/*": "./tools/*"
  },
  "files": [
    "main",
    "preload",
    "shared",
    "renderer",
    "tools",
    "!**/*.test.ts",
    "!**/__fixtures__/**",
    "README.md"
  ],
  "peerDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.7"
  }
}
